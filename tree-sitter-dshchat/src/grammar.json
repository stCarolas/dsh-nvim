{
  "name": "dshchat",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "title"
        },
        {
          "type": "SYMBOL",
          "name": "_user_message"
        },
        {
          "type": "SYMBOL",
          "name": "_assistant_message"
        },
        {
          "type": "SYMBOL",
          "name": "user_header"
        },
        {
          "type": "SYMBOL",
          "name": "assistant_header"
        },
        {
          "type": "SYMBOL",
          "name": "tool_exchange"
        },
        {
          "type": "SYMBOL",
          "name": "tool_call"
        },
        {
          "type": "SYMBOL",
          "name": "code_block"
        },
        {
          "type": "SYMBOL",
          "name": "rule"
        },
        {
          "type": "SYMBOL",
          "name": "quote"
        },
        {
          "type": "SYMBOL",
          "name": "task"
        },
        {
          "type": "SYMBOL",
          "name": "bullet"
        },
        {
          "type": "SYMBOL",
          "name": "ordered"
        },
        {
          "type": "SYMBOL",
          "name": "error"
        },
        {
          "type": "SYMBOL",
          "name": "notice"
        },
        {
          "type": "SYMBOL",
          "name": "blank"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "_eol": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "title": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_title_text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_title_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 4,
        "content": {
          "type": "PATTERN",
          "value": "#[^\\n]*"
        }
      }
    },
    "user_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_user_header_text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_user_header_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "▌ You[^\\n]*"
        }
      }
    },
    "assistant_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_assistant_header_text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_assistant_header_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "▌ Assistant(  \\(interrupted\\))?[^\\n]*"
        }
      }
    },
    "_user_message": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "user_header"
          },
          {
            "type": "SYMBOL",
            "name": "user_prompt"
          }
        ]
      }
    },
    "_assistant_message": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "assistant_header"
          },
          {
            "type": "SYMBOL",
            "name": "assistant_message_header"
          }
        ]
      }
    },
    "user_prompt": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "assistant_message_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "error": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 5,
            "content": {
              "type": "PATTERN",
              "value": "✖ [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "notice": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 5,
            "content": {
              "type": "PATTERN",
              "value": "· [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "rule": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "PATTERN",
              "value": "─+"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "quote": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "PATTERN",
              "value": " *│ [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "task": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "PATTERN",
              "value": " *[☐☑] [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "bullet": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "PATTERN",
              "value": " *• [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "ordered": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "PATTERN",
              "value": " *[0-9]+[.)] [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "tool_exchange": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tool_call"
        },
        {
          "type": "SYMBOL",
          "name": "tool_output_block"
        }
      ]
    },
    "tool_call": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 4,
            "content": {
              "type": "PATTERN",
              "value": "  ⚙ [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "tool_output_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "tool_output"
        }
      }
    },
    "tool_output": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 2,
            "content": {
              "type": "PATTERN",
              "value": "    [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "code_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "code"
        }
      }
    },
    "code": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "  [^\\n]*"
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "blank": {
      "type": "SYMBOL",
      "name": "_eol"
    },
    "text": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
